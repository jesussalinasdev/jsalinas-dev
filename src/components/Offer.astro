---
import { demos, demosReady } from '../data/demos';
import { useTranslations, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const plans = ['one_language', 'two_languages'];
const extras = ['google_maps', 'domain_email'];
---

<section id="offer" class="offer section" aria-labelledby="offer-title">
    <div class="wrap">
        <h2 id="offer-title" class="section-title offer__title" data-arrive>{t('Offer.headline')}</h2>

        <div class="offer__plans">
            {
                plans.map((key, i) => (
                    <article class="plan" data-arrive style={`--i: ${i}`}>
                        <header class="plan__head">
                            <h3 class="plan__name">{t(`Offer.plans.${key}.title`)}</h3>
                            <p class="plan__price">{t(`Offer.plans.${key}.price`)}</p>
                        </header>
                        <p class="plan__desc" set:html={t.rich(`Offer.plans.${key}.desc`)} />
                    </article>
                ))
            }
        </div>

        <div class="offer__extras">
            {
                extras.map((key, i) => (
                    <article class="extra" data-arrive style={`--i: ${i}`}>
                        <h3 class="extra__name">{t(`Offer.plans.${key}.title`)}</h3>
                        <p class="extra__price">{t(`Offer.plans.${key}.price`)}</p>
                        <p class="extra__desc" set:html={t.rich(`Offer.plans.${key}.desc`)} />
                    </article>
                ))
            }
        </div>

        {
            demosReady && (
                <p class="offer__demos">
                    {t('Offer.demos_label')}{' '}
                    {demos.map((demo, i) => (
                        <>
                            {i > 0 && ' · '}
                            <a href={demo.url} target="_blank" rel="noopener noreferrer">
                                {t('Offer.demo_link', { number: i + 1 })}
                            </a>
                        </>
                    ))}
                </p>
            )
        }

        <p class="offer__excluded" data-arrive>{t('Offer.not_included')}</p>
    </div>
</section>

<style>
    .offer {
        background: var(--accent);
        color: var(--on-accent);
    }

    .offer ::selection {
        background: var(--on-accent);
        color: var(--accent);
    }

    .offer :focus-visible {
        outline-color: var(--on-accent);
    }

    .offer__title {
        max-width: 18ch;
        font-size: clamp(2.1rem, 1.3rem + 3.2vw, 4.1rem);
        line-height: 0.96;
        font-weight: 820;
    }

    .offer__plans {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 clamp(2rem, 5vw, 5rem);
        margin-top: clamp(3.5rem, 7vw, 5.5rem);
        border-top: 3px solid var(--on-accent);
    }

    .plan {
        padding-top: 2rem;
    }

    .plan__name {
        font-size: clamp(2rem, 1.5rem + 1.8vw, 3.1rem);
        font-weight: 820;
    }

    .plan__price {
        margin-top: 1rem;
        font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem);
        font-weight: 720;
        font-stretch: 110%;
        line-height: 1.3;
        font-variant-numeric: tabular-nums;
    }

    .plan__desc {
        max-width: 60ch;
        margin-top: 1.5rem;
        color: var(--on-accent-2);
    }

    .offer__extras {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 clamp(2rem, 5vw, 5rem);
        margin-top: clamp(3.5rem, 6vw, 5rem);
        border-top: 1.5px solid var(--on-accent);
    }

    .extra {
        padding-top: 1.75rem;
    }

    .extra__name {
        font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.75rem);
        font-weight: 760;
    }

    .extra__price {
        margin-top: 0.6rem;
        font-weight: 680;
        font-stretch: 108%;
        font-variant-numeric: tabular-nums;
    }

    .extra__desc {
        max-width: 60ch;
        margin-top: 0.9rem;
        color: var(--on-accent-2);
        font-size: 1rem;
    }

    .offer :global(code) {
        background: var(--on-accent);
        color: var(--accent-hot);
    }

    .offer__demos {
        margin-top: 3rem;
        font-weight: 650;
    }

    .offer__demos a {
        text-decoration-thickness: 2px;
    }

    .offer__excluded {
        max-width: 70ch;
        margin-top: clamp(3.5rem, 6vw, 5rem);
        padding-top: 1.5rem;
        border-top: 1.5px solid var(--on-accent);
        color: var(--on-accent-2);
        font-size: 1rem;
    }

    @media (max-width: 760px) {
        .offer__plans,
        .offer__extras {
            grid-template-columns: minmax(0, 1fr);
        }

        .plan + .plan,
        .extra + .extra {
            margin-top: 2.5rem;
            border-top: 1.5px solid var(--on-accent);
        }
    }
</style>
