---
import Icon from './Icon.astro';
import { demos, demosReady } from '../data/demos';
import { useTranslations, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const plans = ['one_language', 'two_languages'];
const extras = ['google_maps', 'domain_email'];
---

<section id="offer" class="offer section" aria-labelledby="offer-title">
    <div class="wrap">
        <h2 id="offer-title" class="section-title offer__title" data-arrive>{t('Offer.headline')}</h2>

        <div class="offer__plans">
            {
                plans.map((key, i) => (
                    <article class="plan" data-arrive style={`--i: ${i}`}>
                        <header class="plan__head">
                            <h3 class="plan__name">{t(`Offer.plans.${key}.title`)}</h3>
                            <p class="plan__price">{t(`Offer.plans.${key}.price`)}</p>
                        </header>
                        <p class="plan__desc" set:html={t.rich(`Offer.plans.${key}.desc`)} />
                    </article>
                ))
            }
        </div>

        <div class="offer__extras">
            {
                extras.map((key, i) => (
                    <article class="extra" data-arrive style={`--i: ${i}`}>
                        <h3 class="extra__name">{t(`Offer.plans.${key}.title`)}</h3>
                        <p class="extra__price">{t(`Offer.plans.${key}.price`)}</p>
                        <p class="extra__desc" set:html={t.rich(`Offer.plans.${key}.desc`)} />
                    </article>
                ))
            }
            <article class="extra extra--other" data-arrive style="--i: 2">
                <h3 class="extra__name">{t('Offer.other.title')}</h3>
                <p class="extra__desc">{t('Offer.other.desc')}</p>
                <a class="extra__cta" href="#contact">
                    {t('Offer.other.cta')}
                    <Icon name="arrow" />
                </a>
            </article>
        </div>

        {
            demosReady && (
                <p class="offer__demos">
                    {t('Offer.demos_label')}{' '}
                    {demos.map((demo, i) => (
                        <>
                            {i > 0 && ' · '}
                            <a href={demo.url} target="_blank" rel="noopener noreferrer">
                                {t('Offer.demo_link', { number: i + 1 })}
                            </a>
                        </>
                    ))}
                </p>
            )
        }

        <p class="offer__excluded" data-arrive>{t('Offer.not_included')}</p>
    </div>
</section>

<style>
    .offer {
        background: var(--accent-deep);
        color: var(--text);
    }

    .offer ::selection {
        background: var(--text);
        color: var(--accent-deep);
    }

    .offer :focus-visible {
        outline-color: var(--text);
    }

    .offer__title {
        max-width: 18ch;
        font-size: clamp(2.1rem, 1.3rem + 3.2vw, 4.1rem);
        line-height: 0.96;
        font-weight: 820;
    }

    .offer__plans {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 clamp(2rem, 5vw, 5rem);
        margin-top: clamp(3.5rem, 7vw, 5.5rem);
        border-top: 3px solid var(--text);
    }

    .plan {
        padding-top: 2rem;
    }

    .plan__name {
        font-size: clamp(2rem, 1.5rem + 1.8vw, 3.1rem);
        font-weight: 820;
    }

    .plan__price {
        margin-top: 1rem;
        font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem);
        font-weight: 720;
        font-stretch: 110%;
        line-height: 1.3;
        font-variant-numeric: tabular-nums;
    }

    .plan__desc {
        max-width: 60ch;
        margin-top: 1.5rem;
        color: var(--on-deep-2);
    }

    .offer__extras {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0 clamp(1.75rem, 3.5vw, 3.5rem);
        margin-top: clamp(3.5rem, 6vw, 5rem);
        border-top: 1.5px solid oklch(96% 0.012 85 / 0.45);
    }

    .extra {
        padding-top: 1.75rem;
    }

    .extra__name {
        font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.75rem);
        font-weight: 760;
    }

    .extra__price {
        margin-top: 0.6rem;
        font-weight: 680;
        font-stretch: 108%;
        font-variant-numeric: tabular-nums;
    }

    .extra__desc {
        max-width: 48ch;
        margin-top: 0.9rem;
        color: var(--on-deep-2);
        font-size: 1rem;
    }

    /* The open door: same column rhythm, set apart by a soft panel */
    .extra--other {
        margin-top: 1.75rem;
        padding: 1.5rem 1.5rem 1.6rem;
        border-radius: var(--radius-panel);
        background: oklch(96% 0.012 85 / 0.08);
        border: 1px solid oklch(96% 0.012 85 / 0.22);
    }

    .extra__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.25rem;
        color: var(--text);
        font-weight: 680;
        font-stretch: 108%;
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 0.3em;
    }

    .extra__cta :global(svg) {
        width: 1.1rem;
        height: 1.1rem;
        transition: transform 0.35s var(--ease-out);
    }

    .extra__cta:hover :global(svg) {
        transform: translateX(3px);
    }

    .offer :global(code) {
        background: oklch(26% 0.08 259);
        color: var(--accent-hot);
    }

    .offer__demos {
        margin-top: 3rem;
        font-weight: 650;
    }

    .offer__demos a {
        text-decoration-thickness: 2px;
    }

    .offer__excluded {
        max-width: none;
        margin-top: clamp(3.5rem, 6vw, 5rem);
        padding-top: 1.5rem;
        border-top: 1.5px solid oklch(96% 0.012 85 / 0.45);
        color: var(--on-deep-2);
        font-size: 1rem;
    }

    @media (max-width: 1100px) {
        .offer__extras {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .extra--other {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 760px) {
        .offer__plans,
        .offer__extras {
            grid-template-columns: minmax(0, 1fr);
        }

        .plan + .plan,
        .extra + .extra {
            margin-top: 2.5rem;
            border-top: 1.5px solid oklch(96% 0.012 85 / 0.45);
        }
    }
</style>
